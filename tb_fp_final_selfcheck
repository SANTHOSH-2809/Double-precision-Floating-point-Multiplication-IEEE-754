    // =========================================================================
    // Deterministic random finite generator
    // =========================================================================

    task random_finite_value;

        output [63:0] random_value;

        integer choice;
        integer exponent_choice;
        reg [31:0] r0;
        reg [31:0] r1;
        reg [31:0] r2;

        begin

            // Use only Verilog $random, which is supported by Vivado 2018.3.
            r0 = $random(random_seed);
            r1 = $random(random_seed);
            r2 = $random(random_seed);

            random_value[63] = r0[0];

            choice = r1 % 100;

            if (choice < 15) begin

                // Subnormal.
                random_value[62:52] = 11'd0;

                random_value[51:20] = r2;
                random_value[19:0]  = r0[19:0];

                if (random_value[51:0] == 52'd0)
                    random_value[0] = 1'b1;

            end
            else begin

                exponent_choice = r2 % 100;

                if (exponent_choice < 20) begin

                    random_value[62:52] =
                        (r0 % 10) + 1;

                end
                else if (exponent_choice < 50) begin

                    random_value[62:52] =
                        (r0 % 21) + 1013;

                end
                else if (exponent_choice < 75) begin

                    random_value[62:52] =
                        (r0 % 10) + 2037;

                end
                else begin

                    random_value[62:52] =
                        (r0 % 2046) + 1;

                end

                random_value[51:20] = r1;
                random_value[19:0]  = r2[19:0];

            end

        end

    endtask

