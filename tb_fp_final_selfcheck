`timescale 1ns / 1ps

// ============================================================================
// FINAL SELF-CHECKING TESTBENCH
// IEEE-754 BINARY64 FLOATING-POINT MULTIPLIER
//
// This testbench is intentionally independent from the DUT algorithm.
//
// Reference model:
//   - Represents every finite operand as: integer_significand * 2^scale
//   - Multiplies the exact integer significands
//   - Finds the leading product bit independently
//   - Performs its own exact right-shift rounding
//   - Generates G/R/S bits independently
//   - Applies all five rounding modes
//   - Handles gradual underflow independently
//
// Verification:
//   - Directed IEEE-754 corner cases
//   - All five rounding modes
//   - Zero / signed zero
//   - Normal / subnormal operands
//   - Subnormal result / gradual underflow
//   - Halfway rounding
//   - Positive / negative overflow
//   - Infinity
//   - QNaN / SNaN
//   - Exception flags
//   - 10,000 deterministic random finite tests
//
// Coverage:
//   - Operand classes
//   - Result classes
//   - Rounding modes
//   - Sign combinations
//   - Exception flags
//   - Normal/subnormal combinations
//   - Half-tie tests
//   - Precision-boundary regression tests
//
// At the end:
//   - All PASS/FAIL counts are printed.
//   - A text coverage report is written to:
//       fp_coverage_report.txt
//
// Compatible with Vivado/XSim 2018.3 using SystemVerilog (.sv).
// Coverage counters are updated inline inside run_case for parser compatibility.
// ============================================================================

module tb_fp_final_selfcheck;

    // =========================================================================
    // DUT signals
    // =========================================================================

    reg [63:0] A;
    reg [63:0] B;
    reg [2:0]  rounding_mode;

    wire [63:0] result;

    wire invalid;
    wire overflow;
    wire underflow;
    wire inexact;

    // =========================================================================
    // Counts
    // =========================================================================

    integer pass_count;
    integer fail_count;
    integer total_count;
    integer random_count;

    integer rm_count [0:4];

    // Class:
    //   0 = zero
    //   1 = subnormal
    //   2 = normal
    //   3 = infinity
    //   4 = NaN
    integer a_class_count [0:4];
    integer b_class_count [0:4];
    integer result_class_count [0:4];

    // Sign combination:
    //   0 = +,+
    //   1 = +,-
    //   2 = -,+
    //   3 = -,-
    integer sign_combo_count [0:3];

    // Operation-class coverage
    integer zero_operation_count;
    integer inf_zero_count;
    integer nan_operation_count;
    integer normal_normal_count;
    integer normal_subnormal_count;
    integer subnormal_normal_count;
    integer subnormal_subnormal_count;

    // Result/exception coverage
    integer result_exact_count;
    integer result_inexact_count;

    integer invalid_count;
    integer overflow_count;
    integer underflow_count;
    integer inexact_flag_count;

    // Explicit rounding-boundary coverage
    integer half_tie_count;

    // Number of directed tests printed
    integer directed_count;

    integer report_fd;

    // Coverage temporaries. These are module-scope for Vivado 2018.3.
    integer cov_a_class;
    integer cov_b_class;
    integer cov_r_class;
    integer cov_sign_index;

    // Simple module-level controls for Vivado 2018.3 compatibility.
    reg tb_verbose;
    reg tb_mark_half_tie;

    // Vivado 2018.3-compatible deterministic random seed.
    integer random_seed;

    // Vivado 2018.3 compatibility:
    // Keep run_case temporary/reference variables at module scope.
    reg [63:0]  expected_result;
    reg         expected_invalid;
    reg         expected_overflow;
    reg         expected_underflow;
    reg         expected_inexact;


    // =========================================================================
    // DUT
    // =========================================================================

    floatingpoint_ieee dut (
        .A(A),
        .B(B),
        .rounding_mode(rounding_mode),
        .final_product(result),
        .invalid(invalid),
        .overflow(overflow),
        .underflow(underflow),
        .inexact(inexact)
    );

    // =========================================================================
    // Utility: classify a binary64 value
    // =========================================================================

    function integer class_of;
        input [63:0] x;

        begin
            if (x[62:52] == 11'h7FF) begin

                if (x[51:0] == 52'd0)
                    class_of = 3;      // Infinity
                else
                    class_of = 4;      // NaN

            end
            else if (x[62:52] == 11'd0) begin

                if (x[51:0] == 52'd0)
                    class_of = 0;      // Zero
                else
                    class_of = 1;      // Subnormal

            end
            else begin

                class_of = 2;          // Normal

            end
        end

    endfunction

    // =========================================================================
    // Utility: rounding-mode name
    // =========================================================================

    function [8*24-1:0] rm_name;
        input [2:0] rm;

        begin
            case (rm)
                3'b000: rm_name = "RNE (ties-to-even)";
                3'b001: rm_name = "RTZ (toward-zero)";
                3'b010: rm_name = "RUP (toward-+inf)";
                3'b011: rm_name = "RDN (toward--inf)";
                3'b100: rm_name = "RNA (ties-to-away)";
                default: rm_name = "UNSUPPORTED";
            endcase
        end

    endfunction

    // =========================================================================
    // INDEPENDENT REFERENCE MODEL
    //
    // Exact finite operand representation:
    //
    //   value = significand * 2^scale
    //
    // Normal:
    //   significand = 2^52 + fraction
    //   scale = unbiased_exp - 52
    //
    // Subnormal:
    //   significand = fraction
    //   scale = -1074
    //
    // Thus:
    //
    //   exact_product = sig_a * sig_b * 2^(scale_a + scale_b)
    //
    // The reference model does NOT use the DUT's normalized-subnormal
    // representation or datapath.
    // =========================================================================

    task reference_model;

        input  [63:0] a_in;
        input  [63:0] b_in;
        input  [2:0]  rm_in;

        output reg [63:0] ref_result;
        output reg        ref_invalid;
        output reg        ref_overflow;
        output reg        ref_underflow;
        output reg        ref_inexact;

        // Fields
        reg sign_a_ref;
        reg sign_b_ref;
        reg sign_r_ref;

        reg [10:0] exp_a_ref;
        reg [10:0] exp_b_ref;

        reg [51:0] frac_a_ref;
        reg [51:0] frac_b_ref;

        // Classes
        reg a_nan_ref;
        reg b_nan_ref;
        reg a_snan_ref;
        reg b_snan_ref;
        reg a_inf_ref;
        reg b_inf_ref;
        reg a_zero_ref;
        reg b_zero_ref;
        reg a_sub_ref;
        reg b_sub_ref;

        // Exact representation
        reg [52:0] sig_a_ref;
        reg [52:0] sig_b_ref;

        reg [105:0] product_ref;

        integer scale_a_ref;
        integer scale_b_ref;
        integer scale_sum_ref;

        integer leading_bit_ref;
        integer i_ref;
        reg found_ref;

        // Normal result
        integer unbiased_result_ref;
        integer normal_shift_ref;
        reg [10:0] exp_field_ref;

        // Subnormal result
        integer sub_power_ref;
        integer sub_shift_ref;

        // Rounded integer significand
        reg [53:0] q_base_ref;
        reg [53:0] q_round_ref;
        reg [52:0] sub_round_ref;

        // G/R/S
        reg guard_ref;
        reg round_ref;
        reg sticky_ref;

        reg round_increment_ref;

        begin

            // =================================================================
            // Defaults
            // =================================================================

            ref_result    = 64'h0000000000000000;
            ref_invalid   = 1'b0;
            ref_overflow  = 1'b0;
            ref_underflow = 1'b0;
            ref_inexact   = 1'b0;

            exp_field_ref = 11'd0;

            sign_a_ref = a_in[63];
            sign_b_ref = b_in[63];
            sign_r_ref = sign_a_ref ^ sign_b_ref;

            exp_a_ref = a_in[62:52];
            exp_b_ref = b_in[62:52];

            frac_a_ref = a_in[51:0];
            frac_b_ref = b_in[51:0];

            // =================================================================
            // Classification
            // =================================================================

            a_nan_ref = (exp_a_ref == 11'h7FF) &&
                        (frac_a_ref != 52'd0);

            b_nan_ref = (exp_b_ref == 11'h7FF) &&
                        (frac_b_ref != 52'd0);

            a_snan_ref = a_nan_ref && (frac_a_ref[51] == 1'b0);
            b_snan_ref = b_nan_ref && (frac_b_ref[51] == 1'b0);

            a_inf_ref = (exp_a_ref == 11'h7FF) &&
                        (frac_a_ref == 52'd0);

            b_inf_ref = (exp_b_ref == 11'h7FF) &&
                        (frac_b_ref == 52'd0);

            a_zero_ref = (exp_a_ref == 11'd0) &&
                         (frac_a_ref == 52'd0);

            b_zero_ref = (exp_b_ref == 11'd0) &&
                         (frac_b_ref == 52'd0);

            a_sub_ref = (exp_a_ref == 11'd0) &&
                        (frac_a_ref != 52'd0);

            b_sub_ref = (exp_b_ref == 11'd0) &&
                        (frac_b_ref != 52'd0);

            // Signaling NaN or infinity*zero -> invalid.
            if (a_snan_ref || b_snan_ref)
                ref_invalid = 1'b1;

            if ((a_inf_ref && b_zero_ref) ||
                (a_zero_ref && b_inf_ref))
                ref_invalid = 1'b1;

            // =================================================================
            // NaN
            // =================================================================

            if (a_nan_ref) begin

                ref_result =
                    {1'b0,
                     11'h7FF,
                     1'b1,
                     frac_a_ref[50:0]};

            end

            else if (b_nan_ref) begin

                ref_result =
                    {1'b0,
                     11'h7FF,
                     1'b1,
                     frac_b_ref[50:0]};

            end

            // =================================================================
            // Infinity * zero
            // =================================================================

            else if ((a_inf_ref && b_zero_ref) ||
                     (a_zero_ref && b_inf_ref)) begin

                ref_result = 64'h7FF8_0000_0000_0000;

            end

            // =================================================================
            // Infinity
            // =================================================================

            else if (a_inf_ref || b_inf_ref) begin

                ref_result =
                    {sign_r_ref,
                     11'h7FF,
                     52'd0};

            end

            // =================================================================
            // Zero
            // =================================================================

            else if (a_zero_ref || b_zero_ref) begin

                ref_result =
                    {sign_r_ref,
                     63'd0};

            end

            // =================================================================
            // FINITE NON-ZERO
            // =================================================================

            else begin

                // -------------------------------------------------------------
                // Exact operand representation
                // -------------------------------------------------------------

                if (a_sub_ref) begin
                    sig_a_ref   = {1'b0, frac_a_ref};
                    scale_a_ref = -1074;
                end
                else begin
                    sig_a_ref   = {1'b1, frac_a_ref};
                    scale_a_ref =
                        $signed({1'b0, exp_a_ref}) - 13'sd1023 - 52;
                end

                if (b_sub_ref) begin
                    sig_b_ref   = {1'b0, frac_b_ref};
                    scale_b_ref = -1074;
                end
                else begin
                    sig_b_ref   = {1'b1, frac_b_ref};
                    scale_b_ref =
                        $signed({1'b0, exp_b_ref}) - 13'sd1023 - 52;
                end

                scale_sum_ref =
                    scale_a_ref + scale_b_ref;

                // -------------------------------------------------------------
                // Exact 106-bit integer product
                // -------------------------------------------------------------

                product_ref =
                    {53'd0, sig_a_ref} *
                    {53'd0, sig_b_ref};

                // -------------------------------------------------------------
                // Find highest product bit
                // -------------------------------------------------------------

                leading_bit_ref = -1;
                found_ref = 1'b0;

                for (i_ref = 105; i_ref >= 0; i_ref = i_ref - 1) begin

                    if (!found_ref && product_ref[i_ref]) begin

                        leading_bit_ref = i_ref;
                        found_ref = 1'b1;

                    end

                end

                // Product cannot be zero for finite non-zero operands,
                // but keep a defensive path.
                if (leading_bit_ref < 0) begin

                    ref_result =
                        {sign_r_ref, 63'd0};

                end

                else begin

                    // ---------------------------------------------------------
                    // Exact normalized exponent
                    // ---------------------------------------------------------

                    unbiased_result_ref =
                        leading_bit_ref + scale_sum_ref;

                    // =========================================================
                    // NORMAL RESULT
                    // =========================================================

                    if (unbiased_result_ref >= -1022) begin

                        // Keep 53 significant bits.
                        normal_shift_ref =
                            leading_bit_ref - 52;

                        // -----------------------------------------------------
                        // Truncated significand
                        // -----------------------------------------------------

                        if (normal_shift_ref <= 0) begin
                            q_base_ref =
                                product_ref << (-normal_shift_ref);
                        end
                        else if (normal_shift_ref <= 105) begin
                            q_base_ref =
                                product_ref >> normal_shift_ref;
                        end
                        else begin
                            q_base_ref = 54'd0;
                        end

                        // -----------------------------------------------------
                        // G/R/S
                        // -----------------------------------------------------

                        guard_ref = 1'b0;
                        round_ref = 1'b0;
                        sticky_ref = 1'b0;

                        if ((normal_shift_ref >= 1) &&
                            (normal_shift_ref <= 106))
                            guard_ref =
                                product_ref[normal_shift_ref - 1];

                        if ((normal_shift_ref >= 2) &&
                            (normal_shift_ref <= 107))
                            round_ref =
                                product_ref[normal_shift_ref - 2];

                        if (normal_shift_ref >= 3) begin

                            if ((normal_shift_ref - 3) >= 105) begin

                                sticky_ref = |product_ref;

                            end
                            else begin

                                sticky_ref = 1'b0;

                                for (i_ref = 0;
                                     i_ref < 106;
                                     i_ref = i_ref + 1) begin

                                    if (i_ref <= normal_shift_ref - 3)
                                        sticky_ref =
                                            sticky_ref |
                                            product_ref[i_ref];

                                end

                            end

                        end

                        ref_inexact =
                            guard_ref |
                            round_ref |
                            sticky_ref;

                        // -----------------------------------------------------
                        // Rounding
                        // -----------------------------------------------------

                        round_increment_ref = 1'b0;

                        case (rm_in)

                            // RoundTiesToEven
                            3'b000: begin

                                if (guard_ref &&
                                    (round_ref ||
                                     sticky_ref ||
                                     q_base_ref[0]))
                                    round_increment_ref = 1'b1;

                            end

                            // RoundTowardZero
                            3'b001: begin

                                round_increment_ref = 1'b0;

                            end

                            // RoundTowardPositive
                            3'b010: begin

                                round_increment_ref =
                                    (!sign_r_ref) &&
                                    ref_inexact;

                            end

                            // RoundTowardNegative
                            3'b011: begin

                                round_increment_ref =
                                    sign_r_ref &&
                                    ref_inexact;

                            end

                            // RoundTiesToAway
                            3'b100: begin

                                if (guard_ref)
                                    round_increment_ref = 1'b1;

                            end

                            default: begin

                                if (guard_ref &&
                                    (round_ref ||
                                     sticky_ref ||
                                     q_base_ref[0]))
                                    round_increment_ref = 1'b1;

                            end

                        endcase

                        // -----------------------------------------------------
                        // Apply rounding
                        // -----------------------------------------------------

                        q_round_ref =
                            q_base_ref +
                            (round_increment_ref ? 54'd1 : 54'd0);

                        // Carry from:
                        //   1.111... -> 10.000...
                        if (q_round_ref[53]) begin

                            q_round_ref =
                                54'h2000_0000_0000_00;

                            unbiased_result_ref =
                                unbiased_result_ref + 1;

                        end

                        // -----------------------------------------------------
                        // Overflow
                        // -----------------------------------------------------

                        if (unbiased_result_ref > 1023) begin

                            ref_overflow = 1'b1;
                            ref_inexact = 1'b1;

                            if ((rm_in == 3'b000) ||
                                (rm_in == 3'b100) ||
                                ((rm_in == 3'b010) &&
                                 !sign_r_ref) ||
                                ((rm_in == 3'b011) &&
                                 sign_r_ref)) begin

                                ref_result =
                                    {sign_r_ref,
                                     11'h7FF,
                                     52'd0};

                            end
                            else begin

                                ref_result =
                                    {sign_r_ref,
                                     11'h7FE,
                                     52'hFFFF_FFFF_FFFFF};

                            end

                        end

                        // -----------------------------------------------------
                        // Pack normal result
                        // -----------------------------------------------------

                        else begin

                            exp_field_ref =
                                unbiased_result_ref + 1023;

                            ref_result =
                                {sign_r_ref,
                                 exp_field_ref,
                                 q_round_ref[51:0]};

                        end

                    end

                    // =========================================================
                    // SUBNORMAL / GRADUAL UNDERFLOW
                    // =========================================================

                    else begin

                        // To express the exact result in minimum-subnormal
                        // units:
                        //
                        //   q_exact =
                        //       product * 2^(scale_sum + 1074)
                        //
                        sub_power_ref =
                            scale_sum_ref + 1074;

                        guard_ref = 1'b0;
                        round_ref = 1'b0;
                        sticky_ref = 1'b0;

                        if (sub_power_ref >= 0) begin

                            // Exact integer result; no bits discarded.
                            q_base_ref =
                                product_ref << sub_power_ref;

                        end

                        else begin

                            sub_shift_ref =
                                -sub_power_ref;

                            if (sub_shift_ref <= 105)
                                q_base_ref =
                                    product_ref >> sub_shift_ref;
                            else
                                q_base_ref = 54'd0;

                            // -------------------------------------------------
                            // G/R/S for the subnormal shift
                            // -------------------------------------------------

                            if ((sub_shift_ref >= 1) &&
                                (sub_shift_ref <= 106))
                                guard_ref =
                                    product_ref[sub_shift_ref - 1];

                            if ((sub_shift_ref >= 2) &&
                                (sub_shift_ref <= 107))
                                round_ref =
                                    product_ref[sub_shift_ref - 2];

                            if (sub_shift_ref >= 3) begin

                                if ((sub_shift_ref - 3) >= 105) begin

                                    sticky_ref = |product_ref;

                                end
                                else begin

                                    sticky_ref = 1'b0;

                                    for (i_ref = 0;
                                         i_ref < 106;
                                         i_ref = i_ref + 1) begin

                                        if (i_ref <= sub_shift_ref - 3)
                                            sticky_ref =
                                                sticky_ref |
                                                product_ref[i_ref];

                                    end

                                end

                            end

                        end

                        ref_inexact =
                            guard_ref |
                            round_ref |
                            sticky_ref;

                        // -----------------------------------------------------
                        // Rounding decision
                        // -----------------------------------------------------

                        round_increment_ref = 1'b0;

                        case (rm_in)

                            3'b000: begin

                                if (guard_ref &&
                                    (round_ref ||
                                     sticky_ref ||
                                     q_base_ref[0]))
                                    round_increment_ref = 1'b1;

                            end

                            3'b001: begin

                                round_increment_ref = 1'b0;

                            end

                            3'b010: begin

                                round_increment_ref =
                                    (!sign_r_ref) &&
                                    ref_inexact;

                            end

                            3'b011: begin

                                round_increment_ref =
                                    sign_r_ref &&
                                    ref_inexact;

                            end

                            3'b100: begin

                                if (guard_ref)
                                    round_increment_ref = 1'b1;

                            end

                            default: begin

                                if (guard_ref &&
                                    (round_ref ||
                                     sticky_ref ||
                                     q_base_ref[0]))
                                    round_increment_ref = 1'b1;

                            end

                        endcase

                        // -----------------------------------------------------
                        // Apply rounding
                        // -----------------------------------------------------

                        sub_round_ref =
                            q_base_ref[52:0] +
                            (round_increment_ref ? 53'd1 : 53'd0);

                        // -----------------------------------------------------
                        // Rounding reaches minimum normal
                        // -----------------------------------------------------

                        if (sub_round_ref[52]) begin

                            ref_result =
                                {sign_r_ref,
                                 11'd1,
                                 52'd0};

                            // Tininess detected after rounding.
                            ref_underflow = 1'b0;

                        end

                        // -----------------------------------------------------
                        // Genuine subnormal result
                        // -----------------------------------------------------

                        else begin

                            ref_result =
                                {sign_r_ref,
                                 11'd0,
                                 sub_round_ref[51:0]};

                            ref_underflow =
                                ref_inexact;

                        end

                    end

                end

            end

        end


    // =========================================================================
    // Coverage update
    // =========================================================================

    endtask

    // =========================================================================
    // Self-checking task
    // =========================================================================

    task run_case;

        input [63:0]  a_in;
        input [63:0]  b_in;
        input [2:0]   rm_in;
        input [255:0] test_name;

        begin

            // -------------------------------------------------------------
            // Independent reference calculation
            // -------------------------------------------------------------

            reference_model(
                a_in,
                b_in,
                rm_in,

                expected_result,

                expected_invalid,
                expected_overflow,
                expected_underflow,
                expected_inexact
            );

            // -------------------------------------------------------------
            // Drive DUT
            // -------------------------------------------------------------

            A = a_in;
            B = b_in;
            rounding_mode = rm_in;

            #1;

            total_count =
                total_count + 1;

            if (tb_mark_half_tie)
                half_tie_count =
                    half_tie_count + 1;

            // ---------------------------------------------------------
            // Coverage counters
            //
            // Kept inline instead of using a separate coverage task.
            // This avoids task-argument parsing problems seen in some
            // Vivado 2018.3/XSim configurations.
            // ---------------------------------------------------------
            cov_a_class = class_of(a_in);
            cov_b_class = class_of(b_in);
            cov_r_class = class_of(result);

            a_class_count[cov_a_class] =
                a_class_count[cov_a_class] + 1;

            b_class_count[cov_b_class] =
                b_class_count[cov_b_class] + 1;

            result_class_count[cov_r_class] =
                result_class_count[cov_r_class] + 1;

            if (rm_in <= 3'b100)
                rm_count[rm_in] =
                    rm_count[rm_in] + 1;

            cov_sign_index =
                {a_in[63], b_in[63]};

            sign_combo_count[cov_sign_index] =
                sign_combo_count[cov_sign_index] + 1;

            if ((cov_a_class == 0) || (cov_b_class == 0))
                zero_operation_count =
                    zero_operation_count + 1;

            if (((cov_a_class == 3) && (cov_b_class == 0)) ||
                ((cov_a_class == 0) && (cov_b_class == 3)))
                inf_zero_count =
                    inf_zero_count + 1;

            if ((cov_a_class == 4) || (cov_b_class == 4))
                nan_operation_count =
                    nan_operation_count + 1;

            if ((cov_a_class == 2) && (cov_b_class == 2))
                normal_normal_count =
                    normal_normal_count + 1;

            if ((cov_a_class == 2) && (cov_b_class == 1))
                normal_subnormal_count =
                    normal_subnormal_count + 1;

            if ((cov_a_class == 1) && (cov_b_class == 2))
                subnormal_normal_count =
                    subnormal_normal_count + 1;

            if ((cov_a_class == 1) && (cov_b_class == 1))
                subnormal_subnormal_count =
                    subnormal_subnormal_count + 1;

            if (inexact)
                result_inexact_count =
                    result_inexact_count + 1;
            else
                result_exact_count =
                    result_exact_count + 1;

            if (invalid)
                invalid_count = invalid_count + 1;

            if (overflow)
                overflow_count = overflow_count + 1;

            if (underflow)
                underflow_count = underflow_count + 1;

            if (inexact)
                inexact_flag_count = inexact_flag_count + 1;

            // -------------------------------------------------------------
            // Compare result + all flags
            // -------------------------------------------------------------

            if ((result === expected_result) &&
                (invalid === expected_invalid) &&
                (overflow === expected_overflow) &&
                (underflow === expected_underflow) &&
                (inexact === expected_inexact)) begin

                pass_count =
                    pass_count + 1;

                if (tb_verbose) begin

                    $display(
                        "[PASS] %0s | RM=%b | RESULT=%h",
                        test_name,
                        rm_in,
                        result
                    );

                end

            end
            else begin

                fail_count =
                    fail_count + 1;

                $display("");
                $display(
                    "[FAIL] %0s | RM=%b",
                    test_name,
                    rm_in
                );

                $display(
                    "       A          = %h",
                    a_in
                );

