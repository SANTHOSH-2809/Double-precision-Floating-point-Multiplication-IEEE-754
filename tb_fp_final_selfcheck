            a_class_count[i_test] = 0;
            b_class_count[i_test] = 0;
            result_class_count[i_test] = 0;
        end

        for (i_test = 0; i_test < 4; i_test = i_test + 1)
            sign_combo_count[i_test] = 0;

        // Deterministic seed.
        random_seed = 32'h20261004;

        $display("");
        $display(
            "============================================================"
        );
        $display(
            " IEEE-754 BINARY64 MULTIPLIER FINAL SELF-CHECK"
        );
        $display(
            " Independent reference model + coverage"
        );
        $display(
            "============================================================"
        );
        $display("");

        // =====================================================================
        // BASIC EXACT TESTS
        // =====================================================================

        run_case(
            64'h0000000000000000,
            64'h0000000000000000,
            3'b000,
            "0 * 0"
        );

        run_case(
            64'h8000000000000000,
            64'h3FF0000000000000,
            3'b000,
            "-0 * 1"
        );

        run_case(
            64'h8000000000000000,
            64'h8000000000000000,
            3'b000,
            "-0 * -0"
        );

        run_case(
            64'h0000000000000000,
            64'h8000000000000000,
            3'b000,
            "+0 * -0"
        );

        run_case(
            64'h3FF0000000000000,
            64'h4000000000000000,
            3'b000,
            "1 * 2"
        );

        run_case(
            64'hBFF0000000000000,
            64'h4000000000000000,
            3'b000,
            "-1 * 2"
        );

        run_case(
            64'h3FF8000000000000,
            64'h3FF8000000000000,
            3'b000,
            "1.5 * 1.5"
        );

        run_case(
            64'h4016000000000000,
            64'h401A000000000000,
            3'b000,
            "5.5 * 6.5"
        );

        // =====================================================================
        // SUBNORMALS / GRADUAL UNDERFLOW
        // =====================================================================

        run_case(
            64'h0000000000000001,
            64'h3FF0000000000000,
            3'b000,
            "MIN_SUBNORMAL * 1"
        );

        run_case(
            64'h000FFFFFFFFFFFFF,
            64'h3FF0000000000000,
            3'b000,
            "MAX_SUBNORMAL * 1"
        );

        run_case(
            64'h0010000000000000,
            64'h3FE0000000000000,
            3'b000,
            "MIN_NORMAL * 0.5"
        );

        // Exact subnormal arithmetic
        run_case(
            64'h0000000000000002,
            64'h3FF0000000000000,
            3'b000,
            "2*MIN_SUBNORMAL * 1"
        );

        run_case(
            64'h000FFFFFFFFFFFFF,
            64'h4000000000000000,
            3'b000,
            "MAX_SUBNORMAL * 2"
        );

        // Deep underflow
        run_all_rounding_modes(
            64'h0000000000000001,
            64'h0000000000000001,
            "MIN_SUBNORMAL * MIN_SUBNORMAL"
        );

        // =====================================================================
        // EXACT HALF-TIE
        //
        // (1 + 2^-52) * 1.5 is a true midpoint for the retained binary64
        // significand under this multiplication.
        // =====================================================================

        tb_mark_half_tie = 1'b1;

        run_all_rounding_modes(
            64'h3FF0000000000001,
            64'h3FF8000000000000,
            "POSITIVE HALF-TIE"
        );

        run_all_rounding_modes(
            64'hBFF0000000000001,
            64'h3FF8000000000000,
            "NEGATIVE HALF-TIE"
        );

        // Tiny half-way case:
        // 2^-1075 lies exactly halfway between zero and MIN_SUBNORMAL.
        run_all_rounding_modes(
            64'h0000000000000001,
            64'h3FE0000000000000,
            "MIN_SUBNORMAL * 0.5"
        );

        tb_mark_half_tie = 1'b0;

        // =====================================================================
        // INEXACT NORMAL RESULTS
        // =====================================================================

        run_case(
            64'h3FF199999999999A,
            64'h3FF199999999999A,
            3'b000,
            "1.1 * 1.1"
        );

        run_case(
            64'h3FF3333333333333,
            64'h3FF3333333333333,
            3'b000,
            "1.2 * 1.2"
        );


        // =====================================================================
        // PRECISION / BOUNDARY REGRESSION TESTS
        // =====================================================================
        //
        // These cases target exact transitions between:
        //   * largest subnormal and smallest normal
        //   * exact half-way rounding points
        //   * smallest representable subnormal values
        //   * maximum finite value and overflow
        //   * adjacent rounding outcomes
        //

        // ---------------------------------------------------------------------
        // Exact transition:
        // 2^-1022 * (1 - 2^-52) = MAX_SUBNORMAL
        // ---------------------------------------------------------------------

        run_case(
            64'h0010000000000000,
            64'h3FEFFFFFFFFFFFFE,
            3'b000,
            "MIN_NORMAL * (1-2^-52)"
        );

        // ---------------------------------------------------------------------
        // Exact halfway between MAX_SUBNORMAL and MIN_NORMAL.
        //
        // Positive:
        //   RNE -> MIN_NORMAL
        //   RTZ -> MAX_SUBNORMAL
        //   RUP -> MIN_NORMAL
        //   RDN -> MAX_SUBNORMAL
        //   RNA -> MIN_NORMAL
        // ---------------------------------------------------------------------

        tb_mark_half_tie = 1'b1;

        run_all_rounding_modes(
            64'h0010000000000000,
            64'h3FEFFFFFFFFFFFFF,
            "NORMAL/SUBNORMAL HALF-TIE"
        );

        // Negative version.
        run_all_rounding_modes(
            64'h8010000000000000,
            64'h3FEFFFFFFFFFFFFF,
            "NEG NORMAL/SUBNORMAL HALF-TIE"
        );

        tb_mark_half_tie = 1'b0;

        // ---------------------------------------------------------------------
        // MAX_SUBNORMAL multiplied by the first representable number above 1.
        // This exact product lies just below MIN_NORMAL.
        // ---------------------------------------------------------------------

        run_all_rounding_modes(
            64'h000FFFFFFFFFFFFF,
            64'h3FF0000000000001,
            "MAX_SUBNORMAL * NEXT_ABOVE_1"
        );

        // ---------------------------------------------------------------------
        // Smallest subnormal * 1.5 is exactly halfway between:
        //   1 * MIN_SUBNORMAL
        //   2 * MIN_SUBNORMAL
        // ---------------------------------------------------------------------

        tb_mark_half_tie = 1'b1;

        run_all_rounding_modes(
            64'h0000000000000001,
            64'h3FF8000000000000,
            "MIN_SUBNORMAL * 1.5"
        );

        // Negative version.
        run_all_rounding_modes(
            64'h8000000000000001,
            64'h3FF8000000000000,
            "NEG MIN_SUBNORMAL * 1.5"
        );

        tb_mark_half_tie = 1'b0;

        // ---------------------------------------------------------------------
        // Overflow boundary:
        //
        // MAX_FINITE * (1 + 2^-52) -> overflow.
        // ---------------------------------------------------------------------

        run_all_rounding_modes(
            64'h7FEFFFFFFFFFFFFF,
            64'h3FF0000000000001,
            "MAX_FINITE * NEXT_ABOVE_1"
        );

        // ---------------------------------------------------------------------
        // Opposite side of the overflow boundary:
        //
        // (MAX_FINITE - 2 ULP) * (1 + 2^-52)
        // -> MAX_FINITE
        // ---------------------------------------------------------------------

        run_all_rounding_modes(
            64'h7FEFFFFFFFFFFFFD,
            64'h3FF0000000000001,
            "MAX_MINUS_2ULP * NEXT_ABOVE_1"
        );

        // Negative versions.
        run_all_rounding_modes(
            64'hFFEFFFFFFFFFFFFF,
            64'h3FF0000000000001,
            "NEG_MAX_FINITE * NEXT_ABOVE_1"
        );

        run_all_rounding_modes(
            64'hFFEFFFFFFFFFFFFD,
            64'h3FF0000000000001,
            "NEG_MAX_MINUS_2ULP * NEXT_ABOVE_1"
        );

        // ---------------------------------------------------------------------
        // Neighboring normal rounding cases.
        // ---------------------------------------------------------------------

        run_case(
            64'h3FF0000000000002,
            64'h3FF8000000000000,
            3'b000,
            "ROUNDING ABOVE HALF-TIE"
        );

        run_case(
            64'h3FF0000000000000,
            64'h3FF8000000000000,
            3'b000,
            "EXACT NORMAL"
        );

        // =====================================================================
        // OVERFLOW
        // =====================================================================

        run_all_rounding_modes(
            64'h7FEFFFFFFFFFFFFF,
            64'h4000000000000000,
            "POSITIVE OVERFLOW"
        );

        run_all_rounding_modes(
            64'hFFEFFFFFFFFFFFFF,
            64'h4000000000000000,
            "NEGATIVE OVERFLOW"
        );

        // =====================================================================
        // INFINITY
        // =====================================================================

        run_case(
            64'h7FF0000000000000,
            64'h3FF0000000000000,
            3'b000,
            "INF * 1"
        );

        run_case(
            64'hFFF0000000000000,
            64'h3FF0000000000000,
            3'b000,
            "-INF * 1"
        );

        run_case(
            64'h7FF0000000000000,
            64'hFFF0000000000000,
            3'b000,
            "INF * -INF"
        );

        run_case(
            64'h7FF0000000000000,
            64'h0000000000000000,
            3'b000,
            "INF * 0"
        );

        run_case(
            64'h7FF0000000000000,
            64'h8000000000000000,
            3'b000,
            "INF * -0"
        );

        // =====================================================================
        // NaN
        // =====================================================================

        run_case(
            64'h7FF8000000000001,
            64'h3FF0000000000000,
            3'b000,
            "QNaN * 1"
        );

        run_case(
            64'h7FF0000000000001,
            64'h3FF0000000000000,
            3'b000,
            "SNaN * 1"
        );

        run_case(
            64'h3FF0000000000000,
            64'h7FF8000000001234,
            3'b000,
            "1 * QNaN"
        );

        run_case(
            64'h3FF0000000000000,
            64'h7FF0000000001234,
            3'b000,
            "1 * SNaN"
        );

        run_case(
            64'h7FF0000000001111,
            64'h7FF0000000002222,
            3'b000,
            "SNaN * SNaN"
        );

        run_case(
            64'h7FF8000000001111,
            64'h7FF0000000002222,
            3'b000,
            "QNaN * SNaN"
        );

        // =====================================================================
        // RANDOM VERIFICATION
        //
        // 2,000 vectors per rounding mode = 10,000 random tests.
        //
        // Random generator intentionally includes:
        //   - zero
        //   - subnormal
        //   - low exponents
        //   - around exponent bias
        //   - near max exponent
        //   - both signs
        // =====================================================================

        tb_verbose = 1'b0;

        $display("");
        $display(
            "Starting 10,000 deterministic random finite tests..."
        );
        $display("");

        for (rm_loop = 0;
             rm_loop < 5;
             rm_loop = rm_loop + 1) begin

            for (i_test = 0;
                 i_test < 2000;
                 i_test = i_test + 1) begin

                random_finite_value(random_A);
                random_finite_value(random_B);

                run_case(
                    random_A,
                    random_B,
                    rm_loop[2:0],
                    "RANDOM_FINITE"
                );

                random_count =
                    random_count + 1;

                if ((random_count % 1000) == 0) begin

                    $display(
                        "  Random progress: %0d / 10000",
                        random_count
                    );

                end

            end

        end

        // =====================================================================
        // FINAL REPORT
        // =====================================================================

        write_coverage_report();

        #1;

        if ((fail_count == 0) &&
            (pass_count == total_count)) begin

            $finish;

        end
        else begin

            $display("");
            $display(
                "Simulation completed with verification failures."
            );
            $finish;

        end

    end

endmodule
